{
  "manifest_version": 3,
  "name": "Waitwell Ticket Alerts",
  "version": "2.4",
  "description": "Glow, chime, desktop notification, Teams message and a live floor-map dashboard for Waitwell tickets.",
  "permissions": [
    "storage",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://*.logic.azure.com/*",
    "https://*.powerplatform.com/*",
    "https://*.powerautomate.com/*",
    "https://*.webhook.office.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Waitwell ticket alerts"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.waitwell.ca/*"
      ],
      "js": [
        "keep-visible.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.waitwell.ca/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "notifier.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
